# MongoDB Connection Settings
# For local MongoDB: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=SmartHospitalDB

# Fallback mode: if set to True, will automatically use mongomock if MongoDB server is offline
ENABLE_OFFLINE_MOCK_FALLBACK=True
